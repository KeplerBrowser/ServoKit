root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,jsx,json,md,svg,ts,tsx,xml,yml,yaml}]
indent_style = space
indent_size = 2

[*.{kt,kts,java}]
indent_style = space
indent_size = 2

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.{c,cpp,h,hpp,m,mm}]
indent_style = space
indent_size = 2

[*.swift]
indent_style = space
indent_size = 2
