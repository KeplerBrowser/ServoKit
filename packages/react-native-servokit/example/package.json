{
  "name": "@servokit/react-native-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "fixtures:sync:android": "cd android && ./gradlew --no-daemon :app:syncFixtureAssets",
    "test:native:android": "cd android && ./gradlew --no-daemon :react-native-servokit:testDebugUnitTest",
    "ios": "react-native run-ios",
    "pods:ios": "cd ios && bundle exec pod install"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-servokit": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/codegen": "0.85.0",
    "@react-native/gradle-plugin": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@react-native/metro-config": "0.85.0",
    "@react-native/typescript-config": "0.85.0",
    "@types/react": "^19.2.0",
    "react-native-builder-bob": "^0.41.0",
    "react-native-monorepo-config": "^0.3.3",
    "@react-native-community/cli-platform-ios": "20.1.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
